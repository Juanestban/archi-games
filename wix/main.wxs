<!--
  Archi Games installer (WiX 5). Per-user: installs to %LOCALAPPDATA%\Programs\Archi Games
  with a Start menu shortcut and never asks for administrator rights (ADR 0001).
  Built by scripts/package.ps1, which passes Version, ExePath and IconPath.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Archi Games"
    Manufacturer="Archi Games"
    Version="$(var.Version)"
    UpgradeCode="05E3306A-08FE-4872-8AD0-71FD428E13EE"
    Scope="perUser"
    Compressed="yes">

    <!-- Installing a newer version replaces the old one. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Archi Games is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Archi Games" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="DD5EDEC4-ACC4-4402-BEDC-F5ECA3BED3DB">
        <File Id="ArchiGamesExe" Source="$(var.ExePath)" Name="archi-games.exe" />
        <!-- Per-user components need an HKCU key path. -->
        <RegistryValue Root="HKCU" Key="Software\Archi Games" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="StartMenuShortcut">
        <Shortcut
          Id="ArchiGamesShortcut"
          Directory="ProgramMenuFolder"
          Name="Archi Games"
          Target="[INSTALLFOLDER]archi-games.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Archi Games" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- After an in-app update (msiexec ... LAUNCHAPP=1), start the new version. -->
    <CustomAction Id="LaunchAfterUpdate" FileRef="ArchiGamesExe" ExeCommand="--after-update" Return="asyncNoWait" Impersonate="yes" Execute="immediate" />
    <InstallExecuteSequence>
      <Custom Action="LaunchAfterUpdate" After="InstallFinalize" Condition="LAUNCHAPP = 1 AND NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
    </Feature>
  </Package>
</Wix>
