lol-name = League of Legends
lol-integration = Live match data
lol-integration-help = Nothing to set up: during each match, Archi Games reads the data the game itself offers on this PC (Riot's Live Client Data API) and counts the match when it ends. Your account links itself in your first match.
lol-integration-waiting = Waiting for a match
lol-integration-receiving = Reading the current match
lol-integration-account = Account: { $name }
lol-running = Match in progress: it counts once it ends.
lol-closed = No match in progress. Practice, bot games and remakes (matches under 5 minutes) don't count.
lol-last-match = Last match counted: { $when }

